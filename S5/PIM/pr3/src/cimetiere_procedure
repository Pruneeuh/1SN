procedure Afficher_Arbre(Arbre : in T_Arbre) is
      procedure Afficher (SS_Arbre : in T_Arbre; c:in Integer; Nb_Espaces : in Integer) is
         Curseur : T_Arbre;
         FG : T_Arbre;
         FD: T_Arbre;
         
      begin
         Curseur := SS_Arbre;
         if Curseur /= Null then
            FG := Curseur.all.Fils_Gauche;
            FD := Curseur.all.Fils_Droit;

            if Nb_Espaces > 0 then
               for i in 1..Nb_Espaces loop
                  Put("|       ");
               end loop;
            end if;
            Put("\--");
            Put(c,1);
            Put("--(");
            Put(Curseur.all.Frequence,1);
            Put(")");
            Put(Curseur.all.Symbole);
            New_Line;

            if FG/=Null then
               if FG.all.Fils_Gauche=Null then

                  for i in 1..Nb_Espaces+1 loop
                     put("|       ");
                  end loop;
                  Put("\--0--(");
                  Put(FG.all.Frequence,1);
                  Put(")");
                  Put(FG.all.Symbole);
                  New_Line;
         
               else 
                  Afficher(FG,0,Nb_Espaces+1);
               end if; 
               Afficher(FD,1,Nb_Espaces+1);
            end if;
              
         end if;
      end Afficher;
   begin
      Put("(");
      Put(Arbre.all.Frequence,1);
      Put(")");
      New_Line;
      Afficher(Arbre.all.Fils_Gauche,0,0);
      Afficher(Arbre.all.Fils_Droit,1,0);

   end Afficher_Arbre;



procedure Reconstuire_Rec(Codage : in Unbounded_String; Arbre : T_Arbre) is 
      procedure Reconstruire(SS_Arbre : T_Arbre ; Codage : in Unbounded_String,Indice : in Integer) is 
         Curseur : T_Arbre; 
         FG : T_Arbre; 
         FD : T_Arbre; 
         Bit_Actuel : Character := To_String(Codage)(Indice);
         Bit_Suivant : Character := To_String(Codage)(Indice +1);
      begin 
         Curseur := SS_Arbre; 
         FG := Le_Fils_Gauche(Curseur);
         FD := Le_Fils_Droit(Curseur);
       
         if Bit_Actuel ='0' then
            if Bit_Suivant ='1' then 
               Creer_FG(FG,'?',0,Arbre_null,Arbre_null);
            else
               Reconstruire(FG, Codage,Indice+1);
            end if; 
            Reconstruire(FD,Codage,Indice+1);
         end if; 
         
      end Reconstuire; 
   begin 
      Reconstruire(Arbre,0,Codage,1);
   end Reconstruire_Rec;  


  procedure Les_Symboles (L_Octets : in Unbounded_String; Symboles_Utilises : out Unbounded_String) is
      indice : Integer ;  --On saute le premier élément qui correspond à la position de "/$"
   begin
      indice := 2;
      Symboles_Utilises := To_Unbounded_String("");
      while To_String(L_Octets)(indice)/= To_String(L_Octets)(indice-1) loop
         Symboles_Utilises := Symboles_Utilises & To_Unbounded_String(To_String(L_Octets)(indice));
