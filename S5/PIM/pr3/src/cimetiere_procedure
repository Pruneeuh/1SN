      end loop;
   end Les_Symboles;  -- elle va pas compiler 



   procedure Decodage(Texte_code : in Unbounded_String; Liste_Symbole : out Unbounded_String; Arbre_Huffman :in out T_Arbre) is
      Liste_Bits_Symbole : Unbounded_String;
      i : integer := 1;
      Symbole : Character;
      Dict_Codage : T_LCA;
   begin
      Creer_Dict (Arbre_Huffman, Dict_Codage);
      Liste_Symbole := To_Unbounded_String(""); 
      while Liste_Bits_Symbole /= La_Valeur(Dict_Codage,'$') loop --faut regler le pb de /$
